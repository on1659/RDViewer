{
  "name": "rdviewer-markdown-reader",
  "version": "0.3.5",
  "private": true,
  "type": "module",
  "description": "A local, read-only Markdown reader inspired by VS Code.",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test server.spec.mjs path-input.spec.mjs project-groups.spec.mjs",
    "open": "node open.mjs",
    "build:mac": "node macos/build.mjs",
    "install:mac": "node macos/build.mjs --install",
    "build:win": "npm --prefix windows ci --ignore-scripts && npm --prefix windows run build",
    "test:win": "npm --prefix windows test"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "11.11.1",
    "markdown-it": "14.3.3"
  }
}
